# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# 测试缓存
.pytest_cache/

# 运行时数据库（由 data/seed_project.json 初始化，不入库）
*.db
*.db-shm
*.db-wal

# 本地环境变量
.env
.env.local

# 工作副本 / 审计快照 / 打包产物（非项目源码）
_work/
_audit/
_pkg/
other/
%TEMP%/
*.7z
pivothub-frontend-baseline-*.zip

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 插件市场：安装到 data/plugins/<id>/ 的内容属于运行时数据
/data/plugins/*/

# Adapter 运行时产物（frps/frpc 配置含随机 token）
/.run/

# 文件暂存 HTTP 服务目录（运行时临时文件）
/data/stage/

# 本地 Agent 记忆 / 工作区数据（非源码，含本地环境信息）
/.workbuddy/
/.zcode/
